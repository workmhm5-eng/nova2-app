{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova2-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7a1190fe-2799-4a29-9b2d-f0dcbc860451","database_name": "nova2-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a5f969a2aadd4454b4660cdcdfcd3a4e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
